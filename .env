# =========================================================
# StiCommande - Production Local Server Environment Configuration
# =========================================================

# Application General
APP_NAME=StiCommande
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:Sm9obkRvZUlzQUZha2VLZXlGb3JUZXN0aW5nMTIzNDU=
APP_URL=http://localhost

# Database Configuration (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sticommande_db
DB_USERNAME=sticommande_user
DB_PASSWORD=secret_sticommande_db_password_2026

# Redis Cache, Sessions & Queues
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret_sticommande_redis_password_2026
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Realtime WebSocket / Reverb Configuration
REVERB_APP_ID=sticommande
REVERB_APP_KEY=sticommande_reverb_key
REVERB_APP_SECRET=sticommande_reverb_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8085
REVERB_SCHEME=http

# Frontend Public API URL (Accessible from client browsers)
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# Runtime Toggles
RUN_MIGRATIONS=true
START_QUEUE_WORKER=true
